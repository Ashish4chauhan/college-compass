generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String

  savedColleges SavedCollege[]

  createdAt DateTime @default(now())
}

model College {
  id              String   @id @default(uuid())
  name            String
  location        String
  fees            Int
  rating          Float

  overview        String

  averagePackage  Float
  highestPackage  Float

  courses         Course[]
  reviews         Review[]
  cutoffs         ExamCutoff[]
  savedBy         SavedCollege[]

  createdAt       DateTime @default(now())

  @@index([name])
  @@index([location])
}

model Course {
  id        String @id @default(uuid())
  name      String

  collegeId String
  college   College @relation(fields: [collegeId], references: [id])
}

model Review {
  id          String @id @default(uuid())
  studentName String
  rating      Float
  comment     String

  collegeId   String
  college     College @relation(fields: [collegeId], references: [id])
}

model ExamCutoff {
  id          String @id @default(uuid())
  exam        String
  openingRank Int
  closingRank Int

  collegeId   String
  college     College @relation(fields: [collegeId], references: [id])
}

model SavedCollege {
  id          String @id @default(uuid())

  userId      String
  collegeId   String

  user        User @relation(fields: [userId], references: [id])
  college     College @relation(fields: [collegeId], references: [id])

  @@unique([userId, collegeId])
}